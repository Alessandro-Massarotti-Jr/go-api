# HTTP
PORT=8080

# Service name, used by RabbitMQ routing keys (services.<APP_NAME>.<topic>) and the listener queue (<APP_NAME>-in)
APP_NAME=go-api

# MongoDB (required: MONGO_URI)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=go_api
MONGO_POSTS_COLLECTION=posts

# Postgres (required)
POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=go_api port=5432 sslmode=disable

# RabbitMQ (required)
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
